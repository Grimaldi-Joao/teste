BURST_WINDOW=8s

# Sem chave e deterministico (padrao):
LLM_PROVIDER=template
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=template-v1

# Google AI Studio (Gemini) via API compativel com OpenAI:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=sua-chave-do-google-ai-studio
# LLM_MODEL=gemini-3.8-flash

# Precos em USD por 1 milhao de tokens. Use zero no free tier.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
